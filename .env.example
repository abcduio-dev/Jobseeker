# Melbourne JobSeeker Configuration

# Server Port
PORT=3000

# Recipient Email for Job Digests
NOTIFICATION_EMAIL=your.email@example.com

# SMTP Server Settings (Example: Gmail)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Melbourne JobSeeker" <your.email@gmail.com>

# Optional: Adzuna Australia Free Developer API
# Register for free at: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
